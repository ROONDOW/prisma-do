# Copie para .env e preencha AO MENOS UMA chave gratuita para ativar o modo híbrido (LLM).
# Sem nenhuma chave, o PRISMA D&O roda no modo determinístico (regras declaradas).
# NUNCA versione o arquivo .env.

# Google Gemini (gratuito) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq (gratuito) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM (gratuito) — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
